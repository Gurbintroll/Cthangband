func modify_stat_value(value: int, amount: int) -> int:
	if amount > 0:
		for i: int in amount:
			if value < 18:
				value += 1
			else:
				value += 10
	elif amount < 0:
		for i: int in (-amount):
			if value >= 18 + 10:
				value -= 10
			elif value > 18:
				value = 18
			elif value > 3:
				value -= 1
	return value
