static func get_random_owner(store_type: int) -> StoreOwner:
	match store_type:
		StoreType.ALCHEMIST:
			return alchemist_owners[Rng.roll_die(alchemist_owners.size()) - 1]
		StoreType.ARMOURY:
			return armoury_owners[Rng.roll_die(armoury_owners.size()) - 1]
		StoreType.BLACK_MARKET:
			return black_market_owners[Rng.roll_die(black_market_owners.size()) - 1]
		StoreType.BOOKSTORE:
			return library_owners[Rng.roll_die(library_owners.size()) - 1]
		StoreType.EMPTY_LOT:
			return empty_store_owners[Rng.roll_die(empty_store_owners.size()) - 1]
		StoreType.GENERAL_STORE:
			return general_store_owners[Rng.roll_die(general_store_owners.size()) - 1]
		StoreType.HALL_OF_RECORDS:
			return hall_owners[Rng.roll_die(hall_owners.size()) - 1]
		StoreType.HOME:
			return home_owners[Rng.roll_die(home_owners.size()) - 1]
		StoreType.INN:
			return inn_owners[Rng.roll_die(inn_owners.size()) - 1]
		StoreType.MAGIC_STORE:
			return magic_shop_owners[Rng.roll_die(magic_shop_owners.size()) - 1]
		StoreType.PAWNBROKERS:
			return pawnbroker_owners[Rng.roll_die(pawnbroker_owners.size()) - 1]
		StoreType.TEMPLE:
			return temple_owners[Rng.roll_die(temple_owners.size()) - 1]
		StoreType.WEAPONSMITH:
			return weaponsmith_owners[Rng.roll_die(weaponsmith_owners.size()) - 1]
	return empty_store_owners[Rng.roll_die(empty_store_owners.size()) - 1]


